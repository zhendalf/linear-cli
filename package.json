{
  "name": "@zhendalf/linear-cli",
  "version": "1.0.1",
  "description": "Handy Linear commands from the command line — git/jj-aware, agent-friendly, runs on Bun.",
  "type": "module",
  "bin": {
    "linear": "./src/main.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": ["src", "package.json"],
  "keywords": [
    "linear",
    "linear.app",
    "cli",
    "issue-tracker",
    "issues",
    "git",
    "jj",
    "jujutsu",
    "productivity",
    "graphql",
    "developer-tools",
    "bun"
  ],
  "license": "ISC",
  "author": "Eugene Beloded",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhendalf/linear-cli.git"
  },
  "homepage": "https://github.com/zhendalf/linear-cli#readme",
  "bugs": {
    "url": "https://github.com/zhendalf/linear-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate-skill-docs": "bun skills/linear-cli/scripts/generate-docs.ts",
    "prepublishOnly": "bun run codegen",
    "prepare": "lefthook install || true"
  },
  "//": "The CLI ships as TypeScript and runs directly on Bun (the bin is src/main.ts). Runtime libraries are real `dependencies` so `bun add` pulls them; only build/lint/type tooling stays in `devDependencies`. Generated GraphQL types (src/__codegen__) are produced by `bun run codegen` and regenerated on publish via prepublishOnly.",
  "dependencies": {
    "@inquirer/prompts": "^7.5.2",
    "@inquirer/search": "^3.0.10",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "env-paths": "^3.0.0",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "open": "^10.1.2",
    "ora": "^8.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sanitize-filename": "^1.6.4",
    "smol-toml": "^1.3.4",
    "string-width": "^7.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/client-preset": "^4.6.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@types/bun": "^1.3.14",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.29",
    "lefthook": "^1.11.13",
    "typescript": "^5.8.3"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
