{
  "name": "@zhendalf/linear-cli",
  "version": "2.0.0",
  "description": "Handy linear commands from the command line",
  "type": "module",
  "bin": {
    "linear": "./dist/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "bun run codegen && bun run scripts/build.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ported": "tsc -p tsconfig.ported.json",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate-skill-docs": "bun skills/linear-cli/scripts/generate-docs.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "^3.2.0",
    "@inquirer/prompts": "^7.5.2",
    "@inquirer/search": "^3.0.10",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "env-paths": "^3.0.0",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "open": "^10.1.2",
    "ora": "^8.2.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sanitize-filename": "^1.6.4",
    "smol-toml": "^1.3.4",
    "string-width": "^7.2.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/client-preset": "^4.6.1",
    "@types/bun": "^1.3.14",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.29",
    "lefthook": "^1.11.13",
    "typescript": "^5.8.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
